// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId           String  @id @unique @default(uuid())
  email            String  @unique
  userName         String 
  password         String 
  balance          Decimal?        @db.Decimal(10, 2)@default(0)
  isProfitable     Boolean @default(false)
  pendingOrder     Int     @default(0)
  activeOrder      Int     @default(0)
  AccountOnTrade   Boolean @default(false)
  createdAt DateTime @default(now())

  orders Order[]
  iKeys  iKey[]
}

model Order {
  orderId    String      @id @unique @default(uuid())
  userId     String
  symbol     String
  side       OrderSide
  quantity   Decimal?         @db.Decimal(4, 2)
  leverage   Int
  openPrice  Decimal?         @db.Decimal(10, 2)
  closePrice Decimal?         @db.Decimal(10, 2)
  pnl        Decimal?         @db.Decimal(10, 2)
  tp         Decimal?         @db.Decimal(10, 2)
  sl         Decimal?         @db.Decimal(10, 2)
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [userId])
}

model Transaction {
  transactionId String          @id @unique @default(uuid())
  userId        String
  orderId       String?
  amount        Decimal         @db.Decimal(10, 2)
  type          TransactionType
  createdAt     DateTime        @default(now())
}

model iKey {
  ikey      String   @id @unique @default(uuid())
  userId    String
  response  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [userId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  FEE
  PROFIT
  LOSS
  SWAP
}

enum OrderStatus {
  PENDING
  RUNNING
  COMPLETED
  CLOSED
}

enum OrderSide {
  BUY
  SELL
}
