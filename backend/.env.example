# Backend service environment configuration
# Copy to .env and fill in real values.

# --- Database (Neon/Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require

# --- Auth ---
JWT_SECRET=change-me
# Should be "production" in prod, unset/development in dev (also controls secure cookie + strict CORS)
NODE_ENV=development

# --- NATS (JetStream) ---
NATS_URL=nats://localhost:4222
NATS_USER=
NATS_PASS=

# --- Redis ---
# Either REDIS_URL, or individual REDIS_HOST/REDIS_PORT/REDIS_PASSWORD
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- CORS (comma-separated list of allowed origins; dev fallback http://localhost:3000) ---
CORS_ORIGIN=http://localhost:3000

# --- Poller gRPC address ---
GRPC_URL=localhost:50051

# --- Optional: backend HTTP port (default 5000) ---
# PORT=5000
